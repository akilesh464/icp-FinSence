# Network Configuration
NETWORK=local
# For ICP mainnet deployment, change to: NETWORK=ic

# ICP Wallet Configuration
WALLET_ID=your_wallet_id_here
# This will be populated after coupon redemption

# Development Environment
REACT_APP_API_URL=http://localhost:3000
REACT_APP_ENV=development

# ICP Mainnet Environment (uncomment for production)
# REACT_APP_API_URL=https://your-canister-id.icp0.io
# REACT_APP_ENV=production

# Cycles Coupon (for initial deployment)
# CYCLES_COUPON=ff941d18-0ee3-46fa-86d1-ebadb1ef0015
